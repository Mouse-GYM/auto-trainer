
[paths]
source =
    */src/auto-trainer-core
    */src/auto-trainer-device
    */src/auto-trainer-video
    */src/auto-trainer-inference
    */src/auto-trainer-model
    */src/auto-trainer-behavior
    */src/auto-trainer-pyside
    tools/
    */site-packages/auto-trainer-core
    */site-packages/auto-trainer-device
    */site-packages/auto-trainer-video
    */site-packages/auto-trainer-inference
    */site-packages/auto-trainer-model
    */site-packages/auto-trainer-behavior
    */site-packages/auto-trainer-pyside

[run]
# branch = true
relative_files = true

source_pkgs =
    autotrainer.core
    autotrainer.device
    autotrainer.behavior
    autotrainer.inference
    # autotrainer.model
    # autotrainer.pyside
    autotrainer.video
    tools.acquisition
    # tools for the main acquisition app_model mainly

omit =
	# not yet sure where these are coming, but coverage get a ref. to these, which are non-existent here:
    config-3.py
    config.py
    shibokensupport/*
    signature_bootstrap.py
    */tests/*
    */auto-trainer-api/*
    */autotrainer/core/testing.py

# allow coverage in python sub-processes (subprocess):
# patch = subprocess  # only valid from coverage 7.10+ but one for py3.8 is stuck lower.
# patch =
#   execv
#   _exit
#   fork
#   subprocess

# so using coverage-enable-subprocess for now.

concurrency = thread,multiprocessing
parallel = true
# still needed

sigterm = true

disable_warnings = module-not-imported
# do not care when one of auto-trainer-* is not imported during a test.

[report]
show_missing = true
include_namespace_packages = true

omit =
    config-3.py
    config.py
    shibokensupport/*
    signature_bootstrap.py
    */tests/*
    */auto-trainer-api/*
    */autotrainer/core/testing.py
